# StepWise AI environment variables
# Copy this file to .env.local and fill in values. NEVER commit real credentials.

# --- AI Provider ---
# Provider abstraction layer. Supported: "mock" (safe offline demo), "openai".
# Never expose provider keys to the frontend; they are only read server-side.
AI_PROVIDER=mock

# OpenAI-compatible settings (used only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Auth ---
# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-secret

# --- Database ---
# Local SQLite path (default). Swap for PostgreSQL later by changing lib/database.
DATABASE_FILE=./data/stepwise.db
